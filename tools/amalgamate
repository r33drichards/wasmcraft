#!/usr/bin/env bash
# Produce dist/wasmcraft.lua: every src/ module inlined into one file with a
# tiny require shim, so it can be dropped onto a CC:Tweaked computer (which has
# no package.path). bit_native.lua is deliberately EXCLUDED — it uses Lua 5.3
# operators that a CC (5.1) parser would reject, and CC provides bit32 anyway.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
mkdir -p dist
OUT=dist/wasmcraft.lua

{
  echo "-- wasmcraft: a WebAssembly interpreter in pure Lua, amalgamated for CC:Tweaked."
  echo "-- Generated by tools/amalgamate. Run as a program:  wasmcraft <module.wasm> [args]"
  echo "local preload, loaded = {}, {}"
  echo "local function require(name)"
  echo "  if loaded[name] ~= nil then return loaded[name] end"
  echo "  local f = preload[name]; if not f then error('module not bundled: '..name) end"
  echo "  local m = f(name); if m == nil then m = true end; loaded[name] = m; return m"
  echo "end"
  for mod in leb int64 bit memory decoder wasi interp wasm; do
    echo "preload['$mod'] = function(...)"
    cat "src/$mod.lua"
    echo "end"
  done

  # bit_native uses Lua 5.3+ operators a 5.1 parser can't read, so embed it as a
  # string and load() it lazily. On Cobalt/CC (bit32 present) this is never run;
  # on lua5.4 it compiles fine. Keeps the bundle portable across both.
  echo "preload['bit_native'] = function(...)"
  echo "  return assert((loadstring or load)([==["
  cat "src/bit_native.lua"
  echo "]==]))()"
  echo "end"

  # façade + CC-aware file runner
  cat <<'RUNNER'
local wasm = require("wasm")
local wasi = require("wasi")

-- public surface
wasmcraft = { load = wasm.load, instantiate = wasm.instantiate, wasi = wasi, set_yield = wasm.set_yield }

-- Under CC:Tweaked, yield to the event loop periodically so long runs (SQLite)
-- don't trip the "too long without yielding" watchdog. queueEvent/pullEvent of a
-- private event resets the timer and resumes in the same tick.
if type(os) == "table" and os.queueEvent and os.pullEvent then
  wasm.set_yield(function() os.queueEvent("wasmcraft_yield"); os.pullEvent("wasmcraft_yield") end, 200000)
end

-- read a file's bytes via CC fs (binary) or standard io
local function read_bytes(path)
  if fs and fs.open then
    local h = fs.open(path, "rb"); if not h then error("cannot open "..path) end
    local data = h.readAll(); h.close(); return data
  end
  local f = assert(io.open(path, "rb")); local d = f:read("*a"); f:close(); return d
end

-- run a WASI command module from bytes; returns exit code
function wasmcraft.run_wasi(bytes, prog_args, writefn)
  local module = wasm.load(bytes)
  local host = wasi.make({ write = writefn or io.write, writeerr = writefn or io.write, args = prog_args or {} })
  local inst = wasm.instantiate(module, { wasi_snapshot_preview1 = host })
  local ok, err = pcall(function() inst:call("_start") end)
  if ok then return 0 end
  if type(err) == "table" and err[wasi.EXIT] then return err.code or 0 end
  error(err)
end

function wasmcraft.run_file(path, args)
  return wasmcraft.run_wasi(read_bytes(path), args or { path })
end

-- auto-run when invoked as a CC/Cobalt program with a filename argument
local _a = { ... }
if _a[1] then
  local code = wasmcraft.run_file(_a[1], _a)
  if code ~= 0 then print("[module exited with code "..tostring(code).."]") end
end
RUNNER
} > "$OUT"

echo "wrote $OUT ($(wc -l < "$OUT") lines, $(wc -c < "$OUT") bytes)"
