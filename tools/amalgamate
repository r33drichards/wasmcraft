#!/usr/bin/env bash
# Produce dist/wasmcraft.lua: every src/ module inlined into one file with a
# tiny require shim, so it can be dropped onto a CC:Tweaked computer (which has
# no package.path). bit_native.lua is deliberately EXCLUDED — it uses Lua 5.3
# operators that a CC (5.1) parser would reject, and CC provides bit32 anyway.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
mkdir -p dist
OUT=dist/wasmcraft.lua

{
  echo "-- wasmcraft: a WebAssembly interpreter in pure Lua, amalgamated for CC:Tweaked."
  echo "-- Generated by tools/amalgamate. Run as a program:  wasmcraft <module.wasm> [args]"
  echo "local preload, loaded = {}, {}"
  echo "local function require(name)"
  echo "  if loaded[name] ~= nil then return loaded[name] end"
  echo "  local f = preload[name]; if not f then error('module not bundled: '..name) end"
  echo "  local m = f(name); if m == nil then m = true end; loaded[name] = m; return m"
  echo "end"
  for mod in leb int64 bit memory decoder wasi interp luabc runtime compiler transpiler wasm sql; do
    echo "preload['$mod'] = function(...)"
    cat "src/$mod.lua"
    echo "end"
  done

  # bit_native uses Lua 5.3+ operators a 5.1 parser can't read, so embed it as a
  # string and load() it lazily. On Cobalt/CC (bit32 present) this is never run;
  # on lua5.4 it compiles fine. Keeps the bundle portable across both.
  echo "preload['bit_native'] = function(...)"
  echo "  return assert((loadstring or load)([==["
  cat "src/bit_native.lua"
  echo "]==]))()"
  echo "end"

  # façade + CC-aware file runner
  cat <<'RUNNER'
local wasm = require("wasm")
local wasi = require("wasi")

-- public surface
wasmcraft = { load = wasm.load, instantiate = wasm.instantiate, wasi = wasi, sql = require("sql"), set_yield = wasm.set_yield, can_jit = wasm.can_jit, precompile_cache = wasm.precompile_cache }
wasmcraft.version = 5 -- bump to make cached copies on in-game computers self-refresh

-- Under CC:Tweaked, yield to the event loop periodically so long runs (SQLite)
-- don't trip the "too long without yielding" watchdog. queueEvent/pullEvent of a
-- private event resets the timer and resumes in the same tick.
if type(os) == "table" and os.queueEvent and os.pullEvent then
  wasm.set_yield(function() os.queueEvent("wasmcraft_yield"); os.pullEvent("wasmcraft_yield") end, 200000)
end

-- read a file's bytes via CC fs (binary) or standard io
local function read_bytes(path)
  if fs and fs.open then
    local h = fs.open(path, "rb"); if not h then error("cannot open "..path) end
    local data = h.readAll(); h.close(); return data
  end
  local f = assert(io.open(path, "rb")); local d = f:read("*a"); f:close(); return d
end

-- run a WASI command module from bytes; returns exit code.
-- opts.mode = "interp" (default) | "jit" (compile to bytecode; Cobalt only, faster).
function wasmcraft.run_wasi(bytes, prog_args, writefn, opts)
  local module = wasm.load(bytes)
  local host = wasi.make({ write = writefn or io.write, writeerr = writefn or io.write, args = prog_args or {} })
  local inst = wasm.instantiate(module, { wasi_snapshot_preview1 = host }, opts)
  local ok, err = pcall(function() inst:call("_start") end)
  if ok then return 0 end
  if type(err) == "table" and err[wasi.EXIT] then return err.code or 0 end
  error(err)
end

function wasmcraft.run_file(path, args, opts)
  return wasmcraft.run_wasi(read_bytes(path), args or { path }, nil, opts)
end

-- A host filesystem backed by CC's fs API (for sql persistence in-game).
local function cc_hostfs(root)
  root = root or ""
  local function full(p)
    if p:sub(1, 1) == "/" then p = p:sub(2) end
    return root == "" and p or fs.combine(root, p)
  end
  return {
    read = function(p) p = full(p); if not fs.exists(p) then return nil end local h = fs.open(p, "rb"); local d = h.readAll(); h.close(); return d end,
    write = function(p, d) p = full(p); local h = fs.open(p, "wb"); h.write(d); h.close() end,
    exists = function(p) return fs.exists(full(p)) end,
    size = function(p) p = full(p); if not fs.exists(p) then return nil end return fs.getSize(p) end,
    unlink = function(p) p = full(p); if fs.exists(p) then fs.delete(p) end end,
    mkdir = function(p) fs.makeDir(full(p)) end,
  }
end

-- Pick a filesystem backend appropriate to the host VM (CC fs, else Lua io).
function wasmcraft.hostfs(root)
  if type(fs) == "table" and fs.open then return cc_hostfs(root) end
  return nil -- sql.open builds a Lua io backend from `root`
end

-- Open a SQLite database with the generic query API and file persistence.
--   opts: { modulePath = "wq.wasm" | module = <bytes>, path = "dir/my.db", root = "" }
-- A slash-containing path is split into a directory (used as the fs root) and a
-- bare filename handed to SQLite, so absolute/nested paths just work.
function wasmcraft.opendb(opts)
  local module = opts.module or read_bytes(opts.modulePath or "wq.wasm")
  local path, root = opts.path, opts.root
  if path and not root then
    local d, n = path:match("^(.*)/([^/]+)$")
    if d then root, path = (d == "" and "/" or d), n end
  end
  return wasmcraft.sql.open({
    module = module, path = path, mode = opts.mode,
    fs = opts.fs or wasmcraft.hostfs(root), root = root,
  })
end

-- auto-run when invoked as a CC/Cobalt program: wasmcraft [--jit] <module.wasm> [args]
local _a = { ... }
local _mode = "interp"
while true do
  if _a[1] == "--interp" then _mode = "interp"
  elseif _a[1] == "--jit" or _a[1] == "--compile" then _mode = "jit"
  elseif _a[1] == "--transpile" then _mode = "transpile"
  elseif _a[1] == "--auto" then _mode = "auto"
  else break end
  table.remove(_a, 1)
end
if _a[1] then
  local code = wasmcraft.run_file(_a[1], _a, { mode = _mode })
  if code ~= 0 then print("[module exited with code "..tostring(code).."]") end
end

-- when loaded as a library (loadfile("wasmcraft")()), hand back the API table
return wasmcraft
RUNNER
} > "$OUT"

echo "wrote $OUT ($(wc -l < "$OUT") lines, $(wc -c < "$OUT") bytes)"
