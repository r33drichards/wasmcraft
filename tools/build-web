#!/usr/bin/env bash
# Bundle a React app (web/app/main.jsx + React + react-reconciler) into a single
# self-contained app.js that the wasmcraft web engine runs through QuickJS. This
# is the only step that needs Node — it happens at BUILD time on a dev machine;
# nothing here ships to ComputerCraft except the resulting app.js.
#
#   Usage:  tools/build-web [entry.jsx] [out.js]
#           defaults: web/app/main.jsx -> web/site/app.js
#
# React renders through a custom react-reconciler host config (web/app/main.jsx),
# not react-dom, so it targets the engine's small DOM directly.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
ENTRY="${1:-web/app/main.jsx}"
OUT="${2:-web/site/app.js}"
BUILD="$ROOT/.web-build"

command -v npm >/dev/null || { echo "npm not found — Node is required to bundle the React app"; exit 1; }

# install the toolchain once into a throwaway dir (kept out of git)
if [ ! -d "$BUILD/node_modules/esbuild" ]; then
  echo "== installing react + react-reconciler + esbuild =="
  mkdir -p "$BUILD"
  ( cd "$BUILD" && npm init -y >/dev/null 2>&1 )
  # the registry can be flaky on first contact — retry a few times
  ok=0
  for attempt in 1 2 3 4; do
    if ( cd "$BUILD" && npm install --no-audit --no-fund react@18 react-reconciler@0.29 esbuild ); then ok=1; break; fi
    echo "npm install failed (attempt $attempt) — retrying"; sleep $((attempt * 2))
  done
  [ "$ok" = 1 ] || { echo "npm install failed after retries"; exit 1; }
fi

# bundle from inside the build dir so `react`/`react-reconciler` resolve from its
# node_modules; the app sources are copied in next to them.
echo "== bundling $ENTRY -> $OUT =="
rm -rf "$BUILD/app"; mkdir -p "$BUILD/app"
cp web/app/*.jsx "$BUILD/app/" 2>/dev/null || true
OUT_ABS="$(cd "$(dirname "$OUT")" && pwd)/$(basename "$OUT")"
( cd "$BUILD" && ./node_modules/.bin/esbuild "app/$(basename "$ENTRY")" \
    --bundle --format=iife --jsx=automatic \
    --define:process.env.NODE_ENV='"production"' \
    --outfile="$OUT_ABS" )
echo "== wrote $OUT ($(wc -c < "$OUT") bytes) =="
