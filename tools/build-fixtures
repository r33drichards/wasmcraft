#!/usr/bin/env bash
# Regenerate every .wasm fixture from source: assemble .wat files, compile the C
# programs and SQLite via `zig cc -target wasm32-wasi`. Run inside nix-shell, or
# it will pull the toolchains via `nix shell`.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
export ZIG_GLOBAL_CACHE_DIR="$ROOT/.zig-cache" ZIG_LOCAL_CACHE_DIR="$ROOT/.zig-cache"

SQLITE_URL="https://www.sqlite.org/2026/sqlite-amalgamation-3530200.zip"
fetch_sqlite() {
  if [ -f csrc/sqlite3.c ]; then return; fi
  echo "== fetching SQLite amalgamation =="
  curl -fsSL "$SQLITE_URL" -o vendor/sqlite-amalg.zip
  ( cd vendor && unzip -oq sqlite-amalg.zip )
  cp vendor/sqlite-amalgamation-3530200/sqlite3.c csrc/sqlite3.c
  cp vendor/sqlite-amalgamation-3530200/sqlite3.h csrc/sqlite3.h
}

# QuickJS (quickjs-ng) powers the web engine's <script>/JS/React support. Fetched
# like SQLite (not vendored) into csrc/web/quickjs/.
QJS_VER="0.10.1"
QJS_URL="https://github.com/quickjs-ng/quickjs/archive/refs/tags/v${QJS_VER}.tar.gz"
fetch_quickjs() {
  if [ -f csrc/web/quickjs/quickjs.c ]; then return; fi
  echo "== fetching QuickJS-ng v${QJS_VER} =="
  curl -fsSL "$QJS_URL" -o vendor/quickjs.tar.gz
  mkdir -p csrc/web/quickjs
  tar -xzf vendor/quickjs.tar.gz -C vendor
  for f in quickjs.c quickjs.h quickjs-atom.h quickjs-opcode.h libregexp.c libregexp.h \
           libregexp-opcode.h libunicode.c libunicode.h libunicode-table.h cutils.c cutils.h \
           xsum.c xsum.h list.h quickjs-c-atomics.h builtin-array-fromasync.h \
           dirent_compat.h; do
    cp "vendor/quickjs-${QJS_VER}/$f" "csrc/web/quickjs/$f" 2>/dev/null || true
  done
  for req in quickjs.c quickjs.h libregexp.c libunicode.c cutils.c xsum.c; do
    [ -f "csrc/web/quickjs/$req" ] || { echo "QuickJS fetch failed: missing $req"; exit 1; }
  done
}

build() {
  fetch_sqlite
  echo "== assembling .wat fixtures =="
  for w in test/wat/*.wat; do
    wat2wasm "$w" -o "wasm/$(basename "${w%.wat}").wasm"
  done
  echo "== compiling C fixtures =="
  zig cc -target wasm32-wasi -Os -o wasm/hello.wasm   csrc/hello.c
  zig cc -target wasm32-wasi -Os -o wasm/compute.wasm csrc/compute.c
  echo "== compiling web engine (HTML/CSS/JS via QuickJS -> draw protocol) =="
  fetch_quickjs
  local QJS=csrc/web/quickjs
  # reactor model: the host calls _initialize then web_init/web_event repeatedly
  # (interactivity), keeping the JS context alive between frames.
  zig cc -target wasm32-wasi -mexec-model=reactor -O2 -DWEB_JS -DCONFIG_VERSION='"ng"' \
    -D_WASI_EMULATED_SIGNAL -D_WASI_EMULATED_PROCESS_CLOCKS -D_WASI_EMULATED_MMAN \
    -Icsrc/web -I"$QJS" -o wasm/web.wasm \
    csrc/web/web.c "$QJS/quickjs.c" "$QJS/libregexp.c" "$QJS/libunicode.c" "$QJS/cutils.c" "$QJS/xsum.c" \
    -lwasi-emulated-signal -lwasi-emulated-process-clocks -lwasi-emulated-mman
  local SQLITE_FLAGS="-DSQLITE_THREADSAFE=0 -DSQLITE_DEFAULT_MEMSTATUS=0 -DSQLITE_DQS=0 \
    -DSQLITE_OMIT_LOAD_EXTENSION -DSQLITE_OMIT_DEPRECATED -DSQLITE_OMIT_WAL -DSQLITE_TEMP_STORE=3"
  echo "== compiling SQLite demo command module (~15s) =="
  zig cc -target wasm32-wasi -O2 $SQLITE_FLAGS -o wasm/sqlite.wasm csrc/sqlite_demo.c csrc/sqlite3.c
  echo "== compiling size-optimized SQLite demo =="
  zig cc -target wasm32-wasi -Oz $SQLITE_FLAGS -o wasm/sqlite-min.wasm csrc/sqlite_demo.c csrc/sqlite3.c
  echo "== compiling wq reactor (generic query API + WASI file persistence) =="
  zig cc -target wasm32-wasi -mexec-model=reactor -Oz $SQLITE_FLAGS -Wl,--export-memory \
    -o wasm/wq.wasm csrc/wq.c csrc/sqlite3.c
  echo "== done =="; ls -la wasm/
}

if command -v wat2wasm >/dev/null && command -v zig >/dev/null; then
  build
else
  exec nix shell nixpkgs#wabt nixpkgs#zig --command bash -c "$(declare -p QJS_VER QJS_URL SQLITE_URL; declare -f build fetch_quickjs fetch_sqlite); ZIG_GLOBAL_CACHE_DIR='$ROOT/.zig-cache' ZIG_LOCAL_CACHE_DIR='$ROOT/.zig-cache' build"
fi
